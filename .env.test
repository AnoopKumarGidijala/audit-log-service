# Configuration for the test suite ONLY - loaded automatically by
# tests/conftest.py (never by the application itself; app/main.py and a
# normal `uvicorn` run always use .env, unaffected by this file). See the
# "Testing" section of README.md.
#
# Safe to commit: every value here is throwaway, used only against the
# ephemeral database provisioned by docker-compose.test.yml, and recreated
# from scratch on every test run. This is NOT the file to put real
# secrets in - that's .env (git-ignored, copied from .env.example).
#
# The database name deliberately ends in "_test" - tests/conftest.py
# refuses to run at all against a database whose name doesn't, as a second,
# independent safety net beyond "just remember to use this file".

DATABASE_URL=postgresql+psycopg2://audit_test:audit_test_password@localhost:5433/audit_log_test

SECRET_KEY=test-only-secret-key-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=audit-log-service
JWT_AUDIENCE=audit-log-service-clients

# Same shape as .env.example's AUTH_USERS (see docs/authorization-design.md)
# so every existing role/tenant-scoped test fixture (tests/conftest.py)
# works unchanged - only the credentials differ. Every user below shares
# one password_hash: the Argon2 hash of "test-password".
AUTH_USERS=[{"username":"writer","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"writer","tenant_id":"tenant-a"},{"username":"reader","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"reader","tenant_id":"tenant-a"},{"username":"writer-b","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"writer","tenant_id":"tenant-b"},{"username":"reader-b","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"reader","tenant_id":"tenant-b"},{"username":"auditor","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"auditor","tenant_id":null},{"username":"admin","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"admin","tenant_id":"tenant-a"},{"username":"writer-no-tenant","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"writer","tenant_id":null},{"username":"reader-no-tenant","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$pCoMPaZxwOXFqsBWK6oT7Q$w6BX9tGINEeuDGzbJ3F/b++zh/j7lRbIruI/PHaI6y8","role":"reader","tenant_id":null}]

RETENTION_WINDOW_DAYS=90

# A single configured origin so tests/test_cors.py can exercise both the
# "explicitly allowed" and "not allowed, denied by default" branches of
# the CORS policy (see docs/defensive-limits-design.md).
CORS_ALLOWED_ORIGINS=["http://allowed-test-origin.example"]
