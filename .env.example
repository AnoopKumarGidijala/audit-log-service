# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored and must never be committed.

# Used by docker-compose.yml to initialize the local PostgreSQL container.
POSTGRES_USER=audit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=audit_log
POSTGRES_PORT=5432

# Used by the application (must match the values above for local docker-compose use).
DATABASE_URL=postgresql+psycopg2://audit:change-me@localhost:5432/audit_log

# JWT auth. Generate a real secret locally, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Small configured user store standing in for user management in this
# prototype (see docs/authorization-design.md). One JSON array, one entry
# per user: username, password, role (writer|reader|auditor|admin), and
# tenant_id (null for auditor/admin, whose reads span every tenant).
# "writer"/"reader" belong to tenant-a; "writer-b"/"reader-b" belong to a
# second tenant, tenant-b, so cross-tenant isolation can be exercised
# locally too.
AUTH_USERS=[{"username":"writer","password":"change-me","role":"writer","tenant_id":"tenant-a"},{"username":"reader","password":"change-me","role":"reader","tenant_id":"tenant-a"},{"username":"writer-b","password":"change-me","role":"writer","tenant_id":"tenant-b"},{"username":"reader-b","password":"change-me","role":"reader","tenant_id":"tenant-b"},{"username":"auditor","password":"change-me","role":"auditor","tenant_id":null},{"username":"admin","password":"change-me","role":"admin","tenant_id":"tenant-a"},{"username":"writer-no-tenant","password":"change-me","role":"writer","tenant_id":null},{"username":"reader-no-tenant","password":"change-me","role":"reader","tenant_id":null}]

# Retention: records with a timestamp older than this many days are
# archived (soft-deleted) when POST /audit/retention/apply is called.
RETENTION_WINDOW_DAYS=90
