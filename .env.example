# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored and must never be committed.

# Used by docker-compose.yml to initialize the local PostgreSQL container.
POSTGRES_USER=audit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=audit_log
POSTGRES_PORT=5432

# Used by the application (must match the values above for local docker-compose use).
DATABASE_URL=postgresql+psycopg2://audit:change-me@localhost:5432/audit_log

# JWT auth. Generate a real secret locally, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A short value, or a known placeholder/default (including the one shown
# below - it's deliberately in the rejection list), is refused at startup
# - see Settings._reject_weak_secret_key in app/core/config.py.
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Not secrets - identifiers distinguishing this service's own tokens from
# any other token that might be signed with the same key. Defaults shown;
# only worth overriding in a multi-service deployment.
JWT_ISSUER=audit-log-service
JWT_AUDIENCE=audit-log-service-clients

# Small configured user store standing in for user management in this
# prototype (see docs/authorization-design.md and
# docs/auth-hardening-design.md). One JSON array, one entry per user:
# username, password_hash (an Argon2 hash - never a plaintext password;
# generate one with `python -c "from app.core.passwords import
# hash_password; print(hash_password('your-password'))"` after installing
# requirements.txt), role (writer|reader|auditor|admin), and tenant_id
# (null for auditor/admin, whose reads span every tenant). "writer"/
# "reader" belong to tenant-a; "writer-b"/"reader-b" belong to a second
# tenant, tenant-b, so cross-tenant isolation can be exercised locally
# too. Every user below shares one example password_hash - the Argon2
# hash of "change-me" - purely for local-dev convenience; a real
# deployment gives each user their own.
AUTH_USERS=[{"username":"writer","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"writer","tenant_id":"tenant-a"},{"username":"reader","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"reader","tenant_id":"tenant-a"},{"username":"writer-b","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"writer","tenant_id":"tenant-b"},{"username":"reader-b","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"reader","tenant_id":"tenant-b"},{"username":"auditor","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"auditor","tenant_id":null},{"username":"admin","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"admin","tenant_id":"tenant-a"},{"username":"writer-no-tenant","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"writer","tenant_id":null},{"username":"reader-no-tenant","password_hash":"$argon2id$v=19$m=65536,t=3,p=4$B4qvS3TVX9yOiG0WBBU4sQ$YcvYqemDgbSxdQvpeNAcnvWaheejoGyzMoZ0up03xis","role":"reader","tenant_id":null}]

# Retention: records with a timestamp older than this many days are
# archived (soft-deleted) when POST /audit/retention/apply is called.
RETENTION_WINDOW_DAYS=90

# Defensive limits (see docs/defensive-limits-design.md). All optional -
# shown here with their built-in defaults, commented out; uncomment and
# adjust only if a deployment needs different values.
# MAX_REQUEST_BODY_BYTES=32768
# MAX_PAYLOAD_BYTES=16384
# MAX_PAYLOAD_DEPTH=10
# MAX_PAYLOAD_STRING_LENGTH=2000
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# SENSITIVE_RATE_LIMIT_MAX_REQUESTS=10
# SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60

# CORS: no cross-origin browser callers are allowed unless listed here
# explicitly (see docs/defensive-limits-design.md). Empty by default.
# CORS_ALLOWED_ORIGINS=["https://your-frontend.example"]
